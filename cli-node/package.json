{
  "name": "atlas-cli",
  "version": "0.7.0",
  "description": "Find, preview, and re-enter your Codex, Claude, Muse, and shell sessions from one terminal hub, backed by tmux.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DEVxEAZY/atlas-cli.git"
  },
  "homepage": "https://github.com/DEVxEAZY/atlas-cli#readme",
  "bugs": {
    "url": "https://github.com/DEVxEAZY/atlas-cli/issues"
  },
  "keywords": [
    "ai-agents",
    "bun",
    "claude",
    "claude-code",
    "cli",
    "codex",
    "coding-agents",
    "developer-tools",
    "ink",
    "linux",
    "muse",
    "session-manager",
    "terminal",
    "tmux",
    "tui"
  ],
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "atlas": "bun src/main.tsx",
    "build": "bun build --compile src/main.tsx --outfile dist/atlas",
    "test": "bun test tests/",
    "typecheck": "tsc -p .",
    "pack:npm": "bun scripts/pack-npm.ts"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "bun-types": "^1.4.2",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "7.0.1",
    "typescript": "5"
  }
}
